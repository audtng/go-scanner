    to: path.Clean(...)
    patterns:
    - pattern: path.Clean($FROM)
  - from: $FROM
    to: fmt.Sprintf(...)
    patterns:
    - pattern: fmt.Sprintf(..., $FROM, ...)
  - from: $FROM
    to: strings.Join(...)
    patterns:
    - pattern: strings.Join(..., $FROM, ...)
  - from: $FROM
    to: filepath.Rel(...)
    patterns:
    - pattern: filepath.Rel(..., $FROM)
  - from: $FROM
    to: filepath.Abs(...)
    patterns:
