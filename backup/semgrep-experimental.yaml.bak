    to: filepath.ToSlash(...)
    patterns:
    - pattern: filepath.ToSlash($FROM)
  - from: $FROM
    to: path.Join(...)
    patterns:
    - pattern: path.Join(..., $FROM, ...)
  - from: $FROM
    to: path.Clean(...)
    patterns:
    - pattern: path.Clean($FROM)
  - from: $FROM
    to: fmt.Sprintf(...)
    patterns:
    - pattern: fmt.Sprintf(..., $FROM, ...)
  pattern-sanitizers:
  - pattern: filepath.Base(...)
  - pattern: path.Base(...)
  - pattern: securejoin.SecureJoin(...)
