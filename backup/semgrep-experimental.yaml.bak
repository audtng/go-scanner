    patterns:
    - pattern: filepath.Join(..., $FROM, ...)
  - from: $FROM
    to: path.Join(...)
    patterns:
    - pattern: path.Join(..., $FROM, ...)
  - from: $FROM
    to: filepath.Dir(...)
