      - pattern-inside: '$ZR, ... := zip.OpenReader(...)

          ...

          '
      - pattern-inside: '$ZR, ... = zip.OpenReader(...)

          ...

          '
      - pattern-inside: '$ZR, ... := zip.NewReader(...)

          ...

          '
      - pattern-inside: '$ZR, ... = zip.NewReader(...)

          ...

          '
  pattern-propagators:
