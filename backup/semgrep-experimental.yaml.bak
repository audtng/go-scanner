rules:
- id: archive-path-traversal
  mode: taint
  severity: ERROR
  message: 'Potential path traversal vulnerability: untrusted archive entry path used
    in filesystem operation without validation'
  languages:
  - go
  paths:
    exclude:
    - '*_test.go'
    - test/**/*.go
    - mock/**/*.go
  options:
    taint_assume_safe_booleans: true
  metadata:
    cwe:
    - 'CWE-22: Improper Limitation of a Pathname to a Restricted Directory (''Path
      Traversal'')'
    owasp:
    - A01:2021 - Broken Access Control
    - A05:2017 - Broken Access Control
    category: security
    technology:
    - go
    confidence: HIGH
    subcategory:
    - vuln
    references:
    - https://owasp.org/www-community/attacks/Path_Traversal
    - https://cwe.mitre.org/data/definitions/22.html
    - https://snyk.io/research/zip-slip-vulnerability
  pattern-sources:
  - pattern: '($HDR : *tar.Header).Name'
  - pattern: '($HDR : tar.Header).Name'
  - pattern: '($HDR : *tar.Header).Linkname'
  - pattern: '($HDR : tar.Header).Linkname'
  - pattern: '($F : *zip.File).Name'
  - pattern: '($F : zip.File).Name'
  - pattern: '($F : *zip.FileHeader).Name'
  - pattern: '($F : zip.FileHeader).Name'
  - patterns:
    - pattern-either:
      - pattern: $HDR.Name
      - pattern: $HDR.Linkname
    - pattern-either:
      - pattern-inside: '$HDR, $ERR := $TR.Next()

          ...

          '
      - pattern-inside: '$HDR, $ERR = $TR.Next()

          ...

          '
  - patterns:
    - pattern: $F.Name
    - pattern-either:
      - pattern-inside: "for ..., $F := range $ZR.File {\n  ...\n}\n"
      - pattern-inside: "for ..., $F = range $ZR.File {\n  ...\n}\n"
  - pattern: $ZR.File[$IDX].Name
  pattern-propagators:
  - from: $FROM
    to: filepath.Join(...)
    patterns:
    - pattern: filepath.Join(..., $FROM, ...)
  - from: $FROM
    to: path.Join(...)
    patterns:
    - pattern: path.Join(..., $FROM, ...)
  - from: $FROM
    to: filepath.Clean(...)
    patterns:
    - pattern: filepath.Clean($FROM)
  - from: $FROM
    to: path.Clean(...)
    patterns:
    - pattern: path.Clean($FROM)
  pattern-sanitizers:
  - pattern: filepath.Base(...)
  - pattern: path.Base(...)
  - by-side-effect: true
    patterns:
    - pattern: filepath.IsLocal($X)
    - focus-metavariable: $X
  pattern-sinks:
  - patterns:
    - pattern-either:
      - pattern: os.Create($PATH)
      - pattern: os.OpenFile($PATH, ...)
      - pattern: os.Open($PATH)
      - pattern: os.ReadFile($PATH)
      - pattern: os.WriteFile($PATH, ...)
      - pattern: os.Mkdir($PATH, ...)
      - pattern: os.MkdirAll($PATH, ...)
      - pattern: os.Remove($PATH)
      - pattern: os.RemoveAll($PATH)
      - pattern: os.Truncate($PATH, ...)
      - pattern: os.Link($OLD, $PATH)
      - pattern: os.Link($PATH, $NEW)
      - pattern: os.Symlink($OLD, $PATH)
      - pattern: os.Symlink($PATH, $NEW)
      - pattern: os.Rename($OLD, $PATH)
      - pattern: os.Rename($PATH, $NEW)
      - pattern: os.Chmod($PATH, ...)
      - pattern: os.Chown($PATH, ...)
      - pattern: os.Lchown($PATH, ...)
    - focus-metavariable: $PATH
- id: go-unmarshaled-path-traversal
  mode: taint
  severity: ERROR
  message: Untrusted path extracted from unmarshaled data is used in a filesystem
    operation without validation, which may allow arbitrary file read or write via
    path traversal.
  metadata:
    cwe:
    - 'CWE-22: Improper Limitation of a Pathname to a Restricted Directory (''Path
      Traversal'')'
    owasp:
    - A01:2021 - Broken Access Control
    category: security
    technology:
    - go
    subcategory:
    - vuln
    confidence: MEDIUM
    likelihood: HIGH
    impact: HIGH
    references:
    - https://cwe.mitre.org/data/definitions/22.html
    - https://owasp.org/www-community/attacks/Path_Traversal
  languages:
  - go
  paths:
    exclude:
    - '*_test.go'
    - test/**/*.go
    - mock/**/*.go
  options:
    taint_assume_safe_booleans: true
  pattern-sources:
  - by-side-effect: true
    patterns:
    - pattern-either:
      - pattern: json.Unmarshal($DATA, &$TARGET)
      - pattern: yaml.Unmarshal($DATA, &$TARGET)
      - pattern: xml.Unmarshal($DATA, &$TARGET)
    - focus-metavariable: $TARGET
  pattern-propagators:
  - from: $FROM
    to: filepath.Join(...)
    patterns:
    - pattern: filepath.Join(..., $FROM, ...)
  - from: $FROM
    to: path.Join(...)
    patterns:
    - pattern: path.Join(..., $FROM, ...)
  pattern-sanitizers:
  - pattern: filepath.Base(...)
  - pattern: path.Base(...)
  - by-side-effect: true
    patterns:
    - pattern: filepath.IsLocal($X)
    - focus-metavariable: $X
  pattern-sinks:
  - patterns:
    - pattern-either:
      - pattern: os.Open($PATH)
      - pattern: os.OpenFile($PATH, ...)
      - pattern: os.Create($PATH)
      - pattern: os.ReadFile($PATH)
      - pattern: os.WriteFile($PATH, ...)
      - pattern: os.Remove($PATH)
      - pattern: os.RemoveAll($PATH)
      - pattern: os.Mkdir($PATH, ...)
      - pattern: os.MkdirAll($PATH, ...)
    - focus-metavariable: $PATH
- id: path-traversal
  mode: taint
  severity: ERROR
  languages:
  - go
  message: Untrusted input used in file operation may allow path traversal outside
    the intended directory
  metadata:
    cwe:
    - 'CWE-22: Improper Limitation of a Pathname to a Restricted Directory (''Path
      Traversal'')'
    - 'CWE-59: Improper Link Resolution Before File Access (''Link Following'')'
    owasp:
    - A01:2021 - Broken Access Control
    - A05:2017 - Broken Access Control
    category: security
    technology:
    - go
    - net/http
    - gin
    - echo
    - fiber
    confidence: HIGH
    references:
    - https://owasp.org/www-community/attacks/Path_Traversal
    - https://cwe.mitre.org/data/definitions/22.html
    - https://cwe.mitre.org/data/definitions/59.html
  paths:
    exclude:
    - '*_test.go'
    - test/**/*.go
    - mock/**/*.go
  options:
    taint_assume_safe_booleans: true
  pattern-sources:
  - pattern: '($REQ : *http.Request).URL.Query().Get(...)'
  - pattern: '($REQ : *http.Request).FormValue(...)'
  - pattern: '($REQ : *http.Request).PostFormValue(...)'
  - pattern: '($HEADER : *multipart.FileHeader).Filename'
  - pattern: (*gin.Context).Query(...)
  - pattern: '($C : *gin.Context).Query(...)'
  - pattern: '($C : *GinContext).Query(...)'
  - pattern: (*gin.Context).PostForm(...)
  - pattern: '($C : *gin.Context).PostForm(...)'
  - pattern: (*gin.Context).Param(...)
  - pattern: '($C : *gin.Context).Param(...)'
  - pattern: (echo.Context).FormValue(...)
  - pattern: '($C : echo.Context).FormValue(...)'
  - pattern: '($C : *EchoContext).FormValue(...)'
  - pattern: '($C : EchoContext).FormValue(...)'
  - pattern: (echo.Context).QueryParam(...)
  - pattern: '($C : echo.Context).QueryParam(...)'
  - pattern: (echo.Context).Param(...)
  - pattern: '($C : echo.Context).Param(...)'
  - pattern: (*fiber.Ctx).Query(...)
  - pattern: '($C : *fiber.Ctx).Query(...)'
  - pattern: '($C : *FiberCtx).Query(...)'
  - pattern: (*fiber.Ctx).FormValue(...)
  - pattern: '($C : *fiber.Ctx).FormValue(...)'
  - pattern: (*fiber.Ctx).Params(...)
  - pattern: '($C : *fiber.Ctx).Params(...)'
  pattern-propagators:
  - from: $FROM
    to: filepath.Join(...)
    patterns:
    - pattern: filepath.Join(..., $FROM, ...)
  - from: $FROM
    to: path.Join(...)
    patterns:
    - pattern: path.Join(..., $FROM, ...)
  - from: $FROM
    to: fmt.Sprintf(...)
    patterns:
    - pattern: fmt.Sprintf(..., $FROM, ...)
  pattern-sanitizers:
  - pattern: filepath.Base(...)
  - pattern: path.Base(...)
  - by-side-effect: true
    patterns:
    - pattern: filepath.IsLocal($X)
    - focus-metavariable: $X
  pattern-sinks:
  - patterns:
    - pattern-either:
      - pattern: os.OpenFile($PATH, ...)
      - pattern: os.Create($PATH)
      - pattern: os.WriteFile($PATH, ...)
      - pattern: os.ReadFile($PATH)
      - pattern: os.Open($PATH)
      - pattern: os.Remove($PATH)
      - pattern: os.RemoveAll($PATH)
      - pattern: (*gin.Context).File($PATH)
      - pattern: '($C : *gin.Context).File($PATH)'
      - pattern: '($C : *GinContext).File($PATH)'
      - pattern: (*gin.Context).FileAttachment($PATH, ...)
      - pattern: '($C : *gin.Context).FileAttachment($PATH, ...)'
      - pattern: (echo.Context).File($PATH)
      - pattern: '($C : echo.Context).File($PATH)'
      - pattern: '($C : *EchoContext).File($PATH)'
      - pattern: '($C : EchoContext).File($PATH)'
      - pattern: (echo.Context).Attachment($PATH, ...)
      - pattern: '($C : echo.Context).Attachment($PATH, ...)'
      - pattern: (*fiber.Ctx).SendFile($PATH, ...)
      - pattern: '($C : *fiber.Ctx).SendFile($PATH, ...)'
      - pattern: '($C : *FiberCtx).SendFile($PATH, ...)'
      - pattern: (*fiber.Ctx).Download($PATH, ...)
      - pattern: '($C : *fiber.Ctx).Download($PATH, ...)'
    - focus-metavariable: $PATH
- id: go-arbitrary-file-read
  mode: taint
  severity: ERROR
  message: Untrusted user input used in file system operation without proper path
    validation or sanitization, potentially allowing arbitrary file access.
  languages:
  - go
  paths:
    exclude:
    - '*_test.go'
    - test/**/*.go
    - mock/**/*.go
  options:
    taint_assume_safe_booleans: true
  metadata:
    cwe:
    - 'CWE-22: Improper Limitation of a Pathname to a Restricted Directory (''Path
      Traversal'')'
    owasp:
    - A01:2021 - Broken Access Control
    category: security
    technology:
    - go
    references:
    - https://cwe.mitre.org/data/definitions/22.html
    - https://owasp.org/www-community/attacks/Path_Traversal
  pattern-sources:
  - pattern: '($REQ : *http.Request).URL.Query().Get(...)'
  - pattern: '($REQ : *http.Request).FormValue(...)'
  - pattern: '($REQ : *http.Request).PostFormValue(...)'
  - pattern: '($REQ : *http.Request).Header.Get(...)'
  - pattern: '($REQ : *http.Request).PathValue(...)'
  - pattern: '($C : *gin.Context).Query(...)'
  - pattern: '($C : *gin.Context).Param(...)'
  - pattern: '($C : *gin.Context).PostForm(...)'
  - pattern: (*gin.Context).Query(...)
  - pattern: '($C : *GinContext).Query(...)'
  - pattern: '($C : *GinContext).Param(...)'
  - pattern: '($C : *GinContext).PostForm(...)'
  - pattern: (*GinContext).Query(...)
  - pattern: '($C : echo.Context).FormValue(...)'
  - pattern: '($C : echo.Context).QueryParam(...)'
  - pattern: '($C : echo.Context).Param(...)'
  - pattern: (echo.Context).FormValue(...)
  - pattern: '($C : EchoContext).FormValue(...)'
  - pattern: '($C : EchoContext).QueryParam(...)'
  - pattern: '($C : EchoContext).Param(...)'
  - pattern: '($C : *EchoContext).FormValue(...)'
  - pattern: '($C : *EchoContext).QueryParam(...)'
  - pattern: '($C : *EchoContext).Param(...)'
  - pattern: (EchoContext).FormValue(...)
  - pattern: '($C : *fiber.Ctx).Query(...)'
  - pattern: '($C : *fiber.Ctx).Params(...)'
  - pattern: '($C : *fiber.Ctx).FormValue(...)'
  - pattern: (*fiber.Ctx).Query(...)
  - pattern: '($C : *FiberCtx).Query(...)'
  - pattern: '($C : *FiberCtx).Params(...)'
  - pattern: '($C : *FiberCtx).FormValue(...)'
  - pattern: (*FiberCtx).Query(...)
  - by-side-effect: true
    patterns:
    - pattern-either:
      - pattern: json.Unmarshal($DATA, &$TARGET)
    - focus-metavariable: $TARGET
  pattern-propagators:
  - from: $FROM
    to: filepath.Join(...)
    patterns:
    - pattern: filepath.Join(..., $FROM, ...)
  - from: $FROM
    to: path.Join(...)
    patterns:
    - pattern: path.Join(..., $FROM, ...)
  pattern-sanitizers:
  - pattern: filepath.Base(...)
  - pattern: path.Base(...)
  - by-side-effect: true
    patterns:
    - pattern: filepath.IsLocal($X)
    - focus-metavariable: $X
  pattern-sinks:
  - patterns:
    - pattern-either:
      - pattern: os.Open($PATH)
      - pattern: os.OpenFile($PATH, ...)
      - pattern: os.ReadFile($PATH)
      - pattern: os.Create($PATH)
      - pattern: os.WriteFile($PATH, ...)
      - pattern: http.ServeFile($W, $REQ, $PATH)
      - pattern: http.ServeFileFS($W, $REQ, $FS, $PATH)
      - pattern: '($C : *gin.Context).File($PATH)'
      - pattern: '($C : *gin.Context).FileAttachment($PATH, ...)'
      - pattern: (*gin.Context).File($PATH)
      - pattern: (*gin.Context).FileAttachment($PATH, ...)
      - pattern: '($C : *GinContext).File($PATH)'
      - pattern: '($C : *GinContext).FileAttachment($PATH, ...)'
      - pattern: (*GinContext).File($PATH)
      - pattern: '($C : echo.Context).File($PATH)'
      - pattern: '($C : echo.Context).Attachment($PATH, ...)'
      - pattern: '($C : echo.Context).Inline($PATH, ...)'
      - pattern: (echo.Context).File($PATH)
      - pattern: '($C : EchoContext).File($PATH)'
      - pattern: '($C : *EchoContext).File($PATH)'
      - pattern: '($C : EchoContext).Attachment($PATH, ...)'
      - pattern: (EchoContext).File($PATH)
      - pattern: '($C : *fiber.Ctx).SendFile($PATH, ...)'
      - pattern: '($C : *fiber.Ctx).Download($PATH, ...)'
      - pattern: (*fiber.Ctx).SendFile($PATH, ...)
      - pattern: '($C : *FiberCtx).SendFile($PATH, ...)'
      - pattern: '($C : *FiberCtx).Download($PATH, ...)'
      - pattern: (*FiberCtx).SendFile($PATH, ...)
    - focus-metavariable: $PATH
- id: go-path-traversal
  mode: taint
  severity: ERROR
  message: Untrusted user input or archive entry used in file path operation without
    sanitization, leading to path traversal.
  languages:
  - go
  metadata:
    cwe:
    - 'CWE-22: Improper Limitation of a Pathname to a Restricted Directory (''Path
      Traversal'')'
    owasp:
    - A01:2021 - Broken Access Control
    - A05:2017 - Broken Access Control
    category: security
    subcategory:
    - vuln
    confidence: HIGH
    likelihood: HIGH
    impact: HIGH
    technology:
    - go
    - net/http
    - gin
    - echo
    - fiber
    references:
    - https://cwe.mitre.org/data/definitions/22.html
    - https://owasp.org/www-community/attacks/Path_Traversal
  paths:
    exclude:
    - '*_test.go'
    - test/**/*.go
    - mock/**/*.go
  options:
    taint_assume_safe_booleans: true
  pattern-sources:
  - pattern: '($REQ : *http.Request).URL.Query().Get(...)'
  - pattern: '($REQ : *http.Request).URL.Path'
  - pattern: '($REQ : *http.Request).URL.RawPath'
  - pattern: '($REQ : *http.Request).URL.RawQuery'
  - pattern: '($REQ : *http.Request).FormValue(...)'
  - pattern: '($REQ : *http.Request).PostFormValue(...)'
  - pattern: '($REQ : *http.Request).Header.Get(...)'
  - pattern: '($REQ : http.Request).URL.Query().Get(...)'
  - pattern: '($REQ : http.Request).URL.Path'
  - pattern: '($REQ : http.Request).FormValue(...)'
  - pattern: '($C : *gin.Context).Query(...)'
  - pattern: '($C : *gin.Context).DefaultQuery(...)'
  - pattern: '($C : *gin.Context).Param(...)'
  - pattern: '($C : *gin.Context).PostForm(...)'
  - pattern: '($C : *GinContext).Query(...)'
  - pattern: '($C : *GinContext).DefaultQuery(...)'
  - pattern: '($C : *GinContext).Param(...)'
  - pattern: '($C : *GinContext).PostForm(...)'
  - pattern: '($C : echo.Context).FormValue(...)'
  - pattern: '($C : echo.Context).QueryParam(...)'
  - pattern: '($C : echo.Context).Param(...)'
  - pattern: '($C : EchoContext).FormValue(...)'
  - pattern: '($C : EchoContext).QueryParam(...)'
  - pattern: '($C : EchoContext).Param(...)'
  - pattern: '($C : *EchoContext).FormValue(...)'
  - pattern: '($C : *EchoContext).QueryParam(...)'
  - pattern: '($C : *EchoContext).Param(...)'
  - pattern: '($C : *fiber.Ctx).Query(...)'
  - pattern: '($C : *fiber.Ctx).Params(...)'
  - pattern: '($C : *fiber.Ctx).FormValue(...)'
  - pattern: '($C : *FiberCtx).Query(...)'
  - pattern: '($C : *FiberCtx).Params(...)'
  - pattern: '($C : *FiberCtx).FormValue(...)'
  - pattern: '($FILE : *zip.File).Name'
  - pattern: '($FILE : zip.File).Name'
  - pattern: '($FILE : *zip.FileHeader).Name'
  - pattern: '($FILE : zip.FileHeader).Name'
  - pattern: '($HDR : *tar.Header).Name'
  - pattern: '($HDR : tar.Header).Name'
  - pattern: '($HDR : *tar.Header).Linkname'
  - pattern: '($HDR : tar.Header).Linkname'
  - patterns:
    - pattern: $FILE.Name
    - pattern-either:
      - pattern-inside: "for ..., $FILE := range $R.File {\n  ...\n}\n"
      - pattern-inside: "for ..., $FILE = range $R.File {\n  ...\n}\n"
  pattern-propagators:
  - from: $FROM
    to: filepath.Join(...)
    patterns:
    - pattern: filepath.Join(..., $FROM, ...)
  - from: $FROM
    to: path.Join(...)
    patterns:
    - pattern: path.Join(..., $FROM, ...)
  - from: $FROM
    to: filepath.Clean(...)
    patterns:
    - pattern: filepath.Clean(..., $FROM, ...)
  - from: $FROM
    to: path.Clean(...)
    patterns:
    - pattern: path.Clean(..., $FROM, ...)
  - from: $FROM
    to: fmt.Sprintf(...)
    patterns:
    - pattern: fmt.Sprintf(..., $FROM, ...)
  - from: $FROM
    to: fmt.Sprint(...)
    patterns:
    - pattern: fmt.Sprint(..., $FROM, ...)
  - from: $FROM
    to: strings.Join(...)
    patterns:
    - pattern: strings.Join(..., $FROM, ...)
  pattern-sanitizers:
  - pattern: filepath.Base(...)
  - pattern: path.Base(...)
  - by-side-effect: true
    patterns:
    - pattern: filepath.IsLocal($X)
    - focus-metavariable: $X
  pattern-sinks:
  - patterns:
    - pattern-either:
      - pattern: os.Open($PATH)
      - pattern: os.OpenFile($PATH, ...)
      - pattern: os.ReadFile($PATH)
      - pattern: os.Create($PATH)
      - pattern: os.Remove($PATH)
      - pattern: os.RemoveAll($PATH)
      - pattern: os.WriteFile($PATH, ...)
      - pattern: os.Mkdir($PATH, ...)
      - pattern: os.MkdirAll($PATH, ...)
      - pattern: os.ReadDir($PATH)
      - pattern: os.Stat($PATH)
      - pattern: http.Dir($PATH)
      - pattern: http.ServeFile($W, $REQ, $PATH)
      - pattern: http.ServeFileFS($W, $REQ, $FS, $PATH)
      - pattern: '($C : *gin.Context).File($PATH)'
      - pattern: '($C : *gin.Context).FileAttachment($PATH, ...)'
      - pattern: '($C : *GinContext).File($PATH)'
      - pattern: '($C : *GinContext).FileAttachment($PATH, ...)'
      - pattern: '($C : echo.Context).File($PATH)'
      - pattern: '($C : echo.Context).Attachment($PATH, ...)'
      - pattern: '($C : echo.Context).Inline($PATH, ...)'
      - pattern: '($C : EchoContext).File($PATH)'
      - pattern: '($C : EchoContext).Attachment($PATH, ...)'
      - pattern: '($C : EchoContext).Inline($PATH, ...)'
      - pattern: '($C : *EchoContext).File($PATH)'
      - pattern: '($C : *EchoContext).Attachment($PATH, ...)'
      - pattern: '($C : *EchoContext).Inline($PATH, ...)'
      - pattern: '($C : *fiber.Ctx).SendFile($PATH, ...)'
      - pattern: '($C : *fiber.Ctx).Download($PATH, ...)'
      - pattern: '($C : *FiberCtx).SendFile($PATH, ...)'
      - pattern: '($C : *FiberCtx).Download($PATH, ...)'
    - focus-metavariable: $PATH
- id: go-path-traversal
  mode: taint
  severity: ERROR
  message: Untrusted user input flows into a filesystem operation without path traversal
    sanitization.
  languages:
  - go
  paths:
    exclude:
    - '*_test.go'
    - test/**/*.go
    - mock/**/*.go
  metadata:
    category: security
    cwe:
    - 'CWE-22: Improper Limitation of a Pathname to a Restricted Directory (''Path
      Traversal'')'
    owasp:
    - A01:2021 - Broken Access Control
    - A05:2017 - Broken Access Control
    references:
    - https://cwe.mitre.org/data/definitions/22.html
    - https://owasp.org/www-community/attacks/Path_Traversal
    confidence: HIGH
    subcategory:
    - vuln
    likelihood: HIGH
    impact: HIGH
    technology:
    - go
    - net/http
    - gin
    - echo
    - fiber
  options:
    taint_assume_safe_booleans: true
  pattern-sources:
  - pattern: '($REQ : *http.Request).URL.Path'
  - pattern: '($REQ : *http.Request).URL.RawPath'
  - pattern: '($REQ : *http.Request).URL.Query().Get(...)'
  - pattern: '($REQ : *http.Request).FormValue(...)'
  - pattern: '($REQ : *http.Request).PostFormValue(...)'
  - pattern: (*gin.Context).Query(...)
  - pattern: '($CTX : *gin.Context).Query(...)'
  - pattern: '($CTX : *GinContext).Query(...)'
  - pattern: (*gin.Context).Param(...)
  - pattern: '($CTX : *gin.Context).Param(...)'
  - pattern: '($CTX : *GinContext).Param(...)'
  - pattern: (echo.Context).FormValue(...)
  - pattern: '($CTX : echo.Context).FormValue(...)'
  - pattern: '($CTX : *EchoContext).FormValue(...)'
  - pattern: (echo.Context).QueryParam(...)
  - pattern: '($CTX : echo.Context).QueryParam(...)'
  - pattern: '($CTX : *EchoContext).QueryParam(...)'
  - pattern: (*fiber.Ctx).Query(...)
  - pattern: '($CTX : *fiber.Ctx).Query(...)'
  - pattern: '($CTX : *FiberCtx).Query(...)'
  - pattern: (*fiber.Ctx).Params(...)
  - pattern: '($CTX : *fiber.Ctx).Params(...)'
  - pattern: '($CTX : *FiberCtx).Params(...)'
  pattern-propagators:
  - from: $FROM
    to: filepath.Join(...)
    patterns:
    - pattern: filepath.Join(..., $FROM, ...)
  - from: $FROM
    to: path.Join(...)
    patterns:
    - pattern: path.Join(..., $FROM, ...)
  - from: $FROM
    to: filepath.Clean(...)
    patterns:
    - pattern: filepath.Clean($FROM)
  - from: $FROM
    to: path.Clean(...)
    patterns:
    - pattern: path.Clean($FROM)
  - from: $FROM
    to: filepath.FromSlash(...)
    patterns:
    - pattern: filepath.FromSlash($FROM)
  - from: $FROM
    to: filepath.ToSlash(...)
    patterns:
    - pattern: filepath.ToSlash($FROM)
